<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>sysscan · folder sizes · {{ r.root }}</title>
<style>
:root {
  --bg: #f7f7f5; --panel: #ffffff; --text: #1d1d1b; --muted: #6b6b66; --line: #e4e3de; --focus: #1d5fa8;
  --bar: #1d5fa8; --bar-bg: #e3edf8;
  --safe: #1f7a4d; --safe-bg: #e3f3ea;
  --caution: #8a5a00; --caution-bg: #f8eed8;
  --keep: #b3261e; --keep-bg: #f9e5e3;
  --unknown: #5b5b57; --unknown-bg: #ecebe7;
  --mono: ui-monospace, "Cascadia Code", Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #161615; --panel: #1f1f1d; --text: #ecebe6; --muted: #9c9b94; --line: #33332f; --focus: #7db3f0;
    --bar: #7db3f0; --bar-bg: #172a40;
    --safe: #5fcf93; --safe-bg: #173326;
    --caution: #e9b85c; --caution-bg: #3a2c10;
    --keep: #f08a82; --keep-bg: #3d1a17;
    --unknown: #b5b4ad; --unknown-bg: #2c2c29;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 15px/1.5 "Segoe UI", system-ui, -apple-system, sans-serif; }
button, input { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.wrap { max-width: 1200px; margin: 0 auto; padding: 32px 20px 64px; }
header h1 { font-size: 26px; margin: 0 0 4px; letter-spacing: -0.01em; }
header .meta { color: var(--muted); font-size: 14px; }
header .meta b { color: var(--text); font-weight: 600; }
.muted { color: var(--muted); }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 24px 0; }
.card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px;
  border-top: 4px solid var(--accent, var(--bar)); text-decoration: none; color: inherit; cursor: pointer; }
.card .n { font-size: 26px; font-weight: 650; color: var(--accent, var(--bar)); line-height: 1.1;
  font-variant-numeric: tabular-nums; }
.card .l { font-size: 13px; color: var(--muted); }
.card.safe { --accent: var(--safe); }
.card.caution { --accent: var(--caution); }
.card.keep { --accent: var(--keep); }
.card.on { box-shadow: inset 0 0 0 2px var(--accent, var(--bar)); }
.legend { font-size: 13px; color: var(--muted); margin: -8px 0 16px; }
.filters { position: sticky; top: 0; z-index: 5; background: var(--bg); padding: 12px 0; margin: 0 0 8px;
  border-bottom: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
#q { flex: 1; min-width: 180px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 8px;
  background: var(--panel); }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { border: 1px solid var(--line); background: var(--panel); border-radius: 99px; padding: 4px 12px;
  font-size: 13px; cursor: pointer; }
.chip.on { background: var(--text); color: var(--bg); border-color: var(--text); }
.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
.row { display: grid;
  grid-template-columns: minmax(140px, 1.3fr) 100px 64px minmax(100px, 1.4fr) minmax(160px, 1.6fr);
  gap: 12px; padding: 12px 16px; align-items: start; border-top: 1px solid var(--line);
  border-left: 4px solid transparent; }
.row.head { border-top: 0; border-left-color: transparent; background: transparent; font-size: 12px; color: var(--muted);
  text-transform: uppercase; letter-spacing: .04em; font-weight: 600; align-items: center; }
.row.head button { background: none; border: 0; padding: 0; cursor: pointer; color: inherit; font: inherit;
  text-transform: inherit; letter-spacing: inherit; font-weight: inherit; }
.row.head button[aria-sort="ascending"]::after { content: " ▲"; }
.row.head button[aria-sort="descending"]::after { content: " ▼"; }
.row.s-safe { border-left-color: var(--safe); background: color-mix(in srgb, var(--safe-bg) 55%, transparent); }
.row.s-caution { border-left-color: var(--caution); background: color-mix(in srgb, var(--caution-bg) 45%, transparent); }
.row.s-keep { border-left-color: var(--keep); }
.row.s-unknown { border-left-color: var(--line); }
.name { font-weight: 600; word-break: break-all; }
.path { font-size: 12px; color: var(--muted); font-family: var(--mono); word-break: break-all; }
.size, .pct { font-variant-numeric: tabular-nums; font-family: var(--mono); font-size: 13px; }
.barwrap { background: var(--bar-bg); border-radius: 6px; height: 10px; overflow: hidden; margin-top: 6px; }
.bar { height: 100%; background: var(--bar); border-radius: 6px; min-width: 0; }
.row.s-safe .bar { background: var(--safe); }
.row.s-caution .bar { background: var(--caution); }
.badge { display: inline-block; font-size: 11px; font-weight: 650; letter-spacing: .02em; padding: 2px 8px;
  border-radius: 99px; margin-bottom: 4px; }
.badge.safe { background: var(--safe-bg); color: var(--safe); }
.badge.caution { background: var(--caution-bg); color: var(--caution); }
.badge.keep { background: var(--keep-bg); color: var(--keep); }
.badge.unknown { background: var(--unknown-bg); color: var(--unknown); }
.src { display: inline-block; margin-left: 6px; padding: 0 6px; border-radius: 4px; font-size: 10px;
  font-weight: 650; letter-spacing: .04em; text-transform: uppercase; background: var(--unknown-bg);
  color: var(--muted); vertical-align: middle; }
.src.ai { background: #e3edf8; color: #1d5fa8; }
@media (prefers-color-scheme: dark) { .src.ai { background: #172a40; color: #7db3f0; } }
.kind { font-size: 12px; color: var(--muted); margin-bottom: 2px; }
.advice { font-size: 13px; color: var(--text); }
.err { font-size: 12px; color: var(--muted); margin-top: 4px; }
.err.has { color: var(--keep); }
.empty { padding: 24px 16px; color: var(--muted); }
.foot { margin-top: 20px; font-size: 12px; color: var(--muted); }
@media (max-width: 800px) {
  .row, .row.head { grid-template-columns: 1fr; gap: 4px; }
  .row.head { display: none; }
  .row > div::before { content: attr(data-label); display: block; font-size: 11px; color: var(--muted);
    text-transform: uppercase; letter-spacing: .04em; margin-bottom: 2px; }
}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Folder sizes</h1>
    <div class="meta">
      <b>{{ r.host }}</b> · under <b>{{ r.root }}</b> (level 1)<br>
      Generated {{ r.generated_at|dt }}
    </div>
  </header>

  <div class="cards">
    <div class="card" data-filter="" title="Show all folders"><div class="n">{{ total_human }}</div><div class="l">Total listed</div></div>
    <div class="card safe" data-filter="safe" title="Folders usually safe to clear">
      <div class="n">{{ safe_human }}</div><div class="l">Safe to clear ({{ r.count_for('safe') }})</div>
    </div>
    <div class="card caution" data-filter="caution" title="Review before deleting">
      <div class="n">{{ caution_human }}</div><div class="l">Review first ({{ r.count_for('caution') }})</div>
    </div>
    <div class="card keep" data-filter="keep" title="Do not delete">
      <div class="n">{{ keep_human }}</div><div class="l">Do not delete ({{ r.count_for('keep') }})</div>
    </div>
  </div>
  <p class="legend">Green = usually safe to clear for free space. Amber = review / partial cleanup. Red = leave alone.
    Built-in rules run first; unknown/review folders can be refined by AI (badge <span class="src">AI</span>).
    Advice is guidance — confirm before deleting.</p>

  <div class="filters">
    <input id="q" type="search" placeholder="Search folder name…" aria-label="Search">
    <div class="chips" id="chips">
      <button type="button" class="chip on" data-filter="">All</button>
      <button type="button" class="chip" data-filter="safe">Safe to clear</button>
      <button type="button" class="chip" data-filter="caution">Review first</button>
      <button type="button" class="chip" data-filter="keep">Do not delete</button>
      <button type="button" class="chip" data-filter="unknown">Unknown</button>
    </div>
    <span class="muted" id="count">{{ r.folders|length }} shown</span>
  </div>

  <div class="panel" id="list">
    <div class="row head" role="row">
      <div><button type="button" class="sort" data-key="name">Folder</button></div>
      <div><button type="button" class="sort" data-key="size" data-dir="desc" aria-sort="descending">Size</button></div>
      <div><button type="button" class="sort" data-key="pct" data-dir="desc">Share</button></div>
      <div>Relative size</div>
      <div><button type="button" class="sort" data-key="safety">Cleanup advice</button></div>
    </div>
    {% if r.folders %}
    {% for f in r.folders %}
    {% set pct = f.pct_of(r.total_bytes) %}
    {% set s = f.safety %}
    <div class="row s-{{ s }}" data-name="{{ f.name|lower }}" data-size="{{ f.bytes }}"
         data-pct="{{ '%.4f'|format(pct) }}" data-safety="{{ s }}" data-safety-rank="{{ safety_rank[s] }}">
      <div data-label="Folder">
        <div class="name">{{ f.name }}</div>
        <div class="path">{{ f.path }}</div>
      </div>
      <div class="size" data-label="Size">{{ f.bytes|human }}</div>
      <div class="pct" data-label="Share">{{ '%.1f'|format(pct) }}%</div>
      <div data-label="Relative size"><div class="barwrap"><div class="bar" style="width: {{ '%.2f'|format(pct) }}%"></div></div></div>
      <div data-label="Cleanup advice">
        <span class="badge {{ s }}">{{ f.advice.label if f.advice else 'Unknown' }}</span>
        {%- if f.advice and f.advice.source.startswith('ai') -%}
          <span class="src ai" title="Classified by AI from the folder name and a sample of its contents">AI</span>
        {%- endif -%}
        {%- if f.advice and f.advice.kind -%}
          <div class="kind">{{ f.advice.kind.replace('_', ' ') }}</div>
        {%- endif -%}
        <div class="advice">{{ f.advice.reason if f.advice else '' }}</div>
        {% if f.errors %}<div class="err has">{{ f.errors }} access error{{ 's' if f.errors != 1 else '' }}</div>{% endif %}
      </div>
    </div>
    {% endfor %}
    {% else %}
    <div class="empty">No subfolders under {{ r.root }}.</div>
    {% endif %}
  </div>

  <p class="foot">sysscan {{ r.tool_version }} · folder size report · advice is guidance only</p>
</div>
<script>
(function () {
  var q = document.getElementById('q');
  var count = document.getElementById('count');
  var list = document.getElementById('list');
  var chips = document.getElementById('chips');
  var cards = [].slice.call(document.querySelectorAll('.card[data-filter]'));
  var rows = [].slice.call(list.querySelectorAll('.row:not(.head)'));
  var sorts = [].slice.call(list.querySelectorAll('.sort'));
  var safetyFilter = '';

  function setFilter(v) {
    safetyFilter = v || '';
    [].slice.call(chips.querySelectorAll('.chip')).forEach(function (c) {
      c.classList.toggle('on', (c.getAttribute('data-filter') || '') === safetyFilter);
    });
    cards.forEach(function (c) {
      c.classList.toggle('on', (c.getAttribute('data-filter') || '') === safetyFilter);
    });
    refresh();
  }

  function refresh() {
    var term = (q.value || '').trim().toLowerCase();
    var n = 0;
    rows.forEach(function (row) {
      var okName = !term || (row.getAttribute('data-name') || '').indexOf(term) !== -1;
      var okSafe = !safetyFilter || row.getAttribute('data-safety') === safetyFilter;
      var ok = okName && okSafe;
      row.style.display = ok ? '' : 'none';
      if (ok) n++;
    });
    count.textContent = n + ' shown';
  }
  q.addEventListener('input', refresh);
  chips.addEventListener('click', function (e) {
    var btn = e.target.closest('.chip');
    if (btn) setFilter(btn.getAttribute('data-filter') || '');
  });
  cards.forEach(function (c) {
    c.addEventListener('click', function () { setFilter(c.getAttribute('data-filter') || ''); });
  });

  sorts.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-key');
      var dir = btn.getAttribute('data-dir') === 'asc' ? 'desc' : 'asc';
      if (btn.getAttribute('aria-sort') === 'ascending') dir = 'desc';
      else if (btn.getAttribute('aria-sort') === 'descending') dir = 'asc';
      sorts.forEach(function (b) { b.removeAttribute('aria-sort'); b.removeAttribute('data-dir'); });
      btn.setAttribute('aria-sort', dir === 'asc' ? 'ascending' : 'descending');
      btn.setAttribute('data-dir', dir);
      rows.sort(function (a, b) {
        var attr = key === 'safety' ? 'data-safety-rank' : ('data-' + key);
        var av = a.getAttribute(attr) || '';
        var bv = b.getAttribute(attr) || '';
        if (key === 'name') return dir === 'asc' ? av.localeCompare(bv) : bv.localeCompare(av);
        av = parseFloat(av) || 0; bv = parseFloat(bv) || 0;
        return dir === 'asc' ? av - bv : bv - av;
      });
      rows.forEach(function (row) { list.appendChild(row); });
    });
  });
})();
</script>
</body>
</html>
