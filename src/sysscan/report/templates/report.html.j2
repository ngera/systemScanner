{%- macro version(c) -%}
  {%- if c.action.value == "updated" and c.version_from and c.version_to -%}
    <span class="old">{{ c.version_from }}</span><span class="new"><span class="arrow">→</span>{{ c.version_to }}</span>
  {%- elif c.action.value == "uninstalled" -%}
    {{ c.version_from or "" }}
  {%- else -%}
    {{ c.version_to or c.version_from or "" }}
  {%- endif -%}
{%- endmacro -%}

{%- macro row(c, routine=False) -%}
{%- set span = date_span(c) -%}
<div class="row a-{{ c.action.value }}" data-action="{{ c.action.value }}" data-cat="{{ c.category.value }}"
     data-prov="{{ c.provider }}" data-d0="{{ span[0] }}" data-d1="{{ span[1] }}" data-sort="{{ sort_key(c) }}"
     data-routine="{{ 1 if routine else 0 }}">
  <div class="c-name"><div class="name">{{ c.name }}{% if c.occurrences > 1 %} <span class="times" title="Happened {{ c.occurrences }} times in this period">×{{ c.occurrences }}</span>{% endif %}</div></div>
  <div class="c-type" data-label="Type"><span class="type t-{{ c.category.value }}">{{ c.category.short_label }}</span></div>
  <div class="c-prov" data-label="Provider"{% if c.publisher and c.publisher != c.provider %} title="{{ c.publisher }}"{% endif %}>
    {%- if c.provider == "Unknown" %}<span class="muted">Unknown</span>{% else %}{{ c.provider }}{% endif -%}
    {%- if c.publisher_source == "ai" %}<span class="src" title="Publisher identified by Claude">AI</span>
    {%- elif c.publisher_source == "yours" %}<span class="src yours" title="From your known_software.toml">yours</span>{% endif -%}
  </div>
  <div class="c-ver ver" data-label="Version">{{ version(c) }}</div>
  <div class="c-date" data-label="Date">
    {%- if c.time -%}{{ c.time|dt if c.confidence.value != "day" else c.time|d }}
    {%- elif c.window_start and c.window_end -%}{{ c.window_start|d }} – {{ c.window_end|d }}
    {%- else -%}unknown{%- endif -%}
    <br><span class="conf">{{ c.confidence.label }}</span>
  </div>
  <div class="c-desc desc">
    {%- if c.description -%}{{ c.description }}<span class="src{{ ' yours' if c.description_source == 'yours' }}">{{ source_label(c.description_source) }}</span>
    {%- if c.source_url %} <a class="srclink" href="{{ c.source_url }}" target="_blank" rel="noopener">source</a>{% endif -%}
    {%- else -%}<span class="nodesc">No description available.</span>{%- endif -%}
    {%- if needs_tagging(c) %} <button type="button" class="tagbtn" data-cmd="{{ tag_command(c) }}"
      title="Copy a command that records what this is; edit it, run it, then `sysscan retag`">Tag it</button>{% endif -%}
    <details class="ev"><summary>Evidence ({{ c.evidence|length }})</summary><ul>
      {%- for e in c.evidence %}<li><code>{{ e.source }}</code> {{ e.detail }}{% if e.time %} · {{ e.time|dt }}{% endif %}</li>{% endfor -%}
    </ul></details>
  </div>
</div>
{%- endmacro -%}

{%- macro head() -%}
<div class="row head" role="row">
  <div><button type="button" class="sort" data-key="name">Name</button></div>
  <div><button type="button" class="sort" data-key="cat">Type</button></div>
  <div><button type="button" class="sort" data-key="prov">Provider</button></div>
  <div>Version</div>
  <div><button type="button" class="sort" data-key="date" data-dir="desc" aria-sort="descending">Date</button></div>
  <div>What it is</div>
</div>
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>sysscan · {{ r.host }} · {{ r.period_start|d }} → {{ r.period_end|d }}</title>
<style>
:root {
  --bg: #f7f7f5; --panel: #ffffff; --text: #1d1d1b; --muted: #6b6b66; --line: #e4e3de; --focus: #1d5fa8;
  --installed: #1f7a4d; --installed-bg: #e3f3ea;
  --updated: #1d5fa8; --updated-bg: #e3edf8;
  --uninstalled: #b3261e; --uninstalled-bg: #f9e5e3;
  --changed: #8a5a00; --changed-bg: #f8eed8;
  --modified: #5b5b57; --modified-bg: #ecebe7;
  --warn-bg: #fff7e0; --warn-line: #f0d68a;
  --chip: #efeee9; --chip-on: #1d1d1b; --chip-on-text: #ffffff;
  --t-desktop: #4b4fa8; --t-store: #1f7a70; --t-wu: #1d5fa8; --t-driver: #9a4a12; --t-dev: #7a3f8f;
  --mono: ui-monospace, "Cascadia Code", Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #161615; --panel: #1f1f1d; --text: #ecebe6; --muted: #9c9b94; --line: #33332f; --focus: #7db3f0;
    --installed: #5fcf93; --installed-bg: #173326;
    --updated: #7db3f0; --updated-bg: #172a40;
    --uninstalled: #f08a82; --uninstalled-bg: #3d1a17;
    --changed: #e9b85c; --changed-bg: #3a2c10;
    --modified: #b5b4ad; --modified-bg: #2c2c29;
    --warn-bg: #2f2912; --warn-line: #6b5a1d; --chip: #2c2c29; --chip-on: #ecebe6; --chip-on-text: #161615;
    --t-desktop: #a9acf5; --t-store: #6fd3c6; --t-wu: #7db3f0; --t-driver: #f0a36b; --t-dev: #d7a3ea;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 15px/1.5 "Segoe UI", system-ui, -apple-system, sans-serif; }
button, input, select { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.wrap { max-width: 1320px; margin: 0 auto; padding: 32px 20px 64px; }
header h1 { font-size: 26px; margin: 0 0 4px; letter-spacing: -0.01em; }
header .meta { color: var(--muted); font-size: 14px; }
header .meta b { color: var(--text); font-weight: 600; }
.demo { display: inline-block; margin-left: 8px; padding: 1px 8px; border-radius: 99px; font-size: 12px;
  background: var(--changed-bg); color: var(--changed); vertical-align: middle; }
.muted { color: var(--muted); }

/* summary cards */
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 24px 0; }
.card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px;
  text-decoration: none; color: inherit; border-top: 4px solid var(--accent); }
.card .n { font-size: 30px; font-weight: 650; color: var(--accent); line-height: 1.1; font-variant-numeric: tabular-nums; }
.card .l { font-size: 13px; color: var(--muted); }
.card .sub { font-size: 12px; color: var(--muted); min-height: 18px; }
.card.zero { opacity: .55; }
.a-installed { --accent: var(--installed); --accent-bg: var(--installed-bg); }
.a-updated { --accent: var(--updated); --accent-bg: var(--updated-bg); }
.a-uninstalled { --accent: var(--uninstalled); --accent-bg: var(--uninstalled-bg); }
.a-changed { --accent: var(--changed); --accent-bg: var(--changed-bg); }
.a-modified { --accent: var(--modified); --accent-bg: var(--modified-bg); }
.warn { background: var(--warn-bg); border: 1px solid var(--warn-line); border-radius: 10px; padding: 10px 14px;
  margin: 0 0 20px; font-size: 14px; }
.warn ul { margin: 4px 0 0; padding-left: 20px; }

/* filter bar */
.filters { position: sticky; top: 0; z-index: 5; background: var(--bg); padding: 12px 0; margin: 0 0 8px;
  border-bottom: 1px solid var(--line); }
.frow { display: flex; flex-wrap: wrap; gap: 10px 18px; align-items: center; }
.frow + .frow { margin-top: 10px; }
.field { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
.field > .lbl { font-weight: 600; text-transform: uppercase; letter-spacing: .05em; font-size: 11px; }
#q { flex: 1 1 280px; padding: 8px 12px; border-radius: 8px; border: 1px solid var(--line); background: var(--panel); }
input[type=date], select { padding: 6px 8px; border-radius: 8px; border: 1px solid var(--line); background: var(--panel);
  color: var(--text); font-size: 13px; }
select { max-width: 240px; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { border: 1px solid var(--line); background: var(--panel); border-radius: 99px; padding: 3px 10px; cursor: pointer;
  font-size: 13px; color: var(--text); }
.chip .cnt { color: var(--muted); font-variant-numeric: tabular-nums; margin-left: 2px; }
.chip[aria-pressed=true] { background: var(--chip-on); color: var(--chip-on-text); border-color: var(--chip-on); }
.chip[aria-pressed=true] .cnt { color: inherit; opacity: .7; }
.preset { border: 0; background: none; color: var(--focus); cursor: pointer; font-size: 13px; padding: 2px 4px; }
.linkbtn { border: 1px solid var(--line); background: var(--panel); border-radius: 8px; padding: 5px 12px; cursor: pointer;
  font-size: 13px; }
.status { margin-left: auto; font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
.check { display: flex; gap: 6px; align-items: center; font-size: 13px; color: var(--muted); white-space: nowrap; cursor: pointer; }

/* sections & table */
section.action { margin: 32px 0 0; }
section.action > h2 { font-size: 20px; margin: 0; display: flex; align-items: center; gap: 10px; }
section.action > h2 .pill { font-size: 13px; padding: 2px 10px; border-radius: 99px;
  background: var(--accent-bg); color: var(--accent); font-weight: 600; font-variant-numeric: tabular-nums; }
section.action > p.blurb { color: var(--muted); margin: 4px 0 12px; font-size: 14px; }
.rows { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
.row { display: grid;
  grid-template-columns: minmax(170px, 1.35fr) 118px minmax(100px, .8fr) minmax(110px, .75fr) minmax(125px, .8fr) minmax(220px, 2fr);
  gap: 14px; padding: 11px 16px; border-top: 1px solid var(--line); border-left: 3px solid var(--accent); }
.row.head { border-top: 0; border-left-color: transparent; padding-top: 8px; padding-bottom: 8px; font-size: 11px;
  text-transform: uppercase; letter-spacing: .05em; color: var(--muted); font-weight: 600; background: var(--bg); }
.row.head + .row { border-top: 1px solid var(--line); }
.sort { border: 0; background: none; padding: 0; cursor: pointer; text-transform: inherit; letter-spacing: inherit;
  font-size: inherit; font-weight: inherit; color: inherit; }
.sort::after { content: " ↕"; opacity: .35; }
.sort[aria-sort=ascending]::after { content: " ↑"; opacity: 1; }
.sort[aria-sort=descending]::after { content: " ↓"; opacity: 1; }
.row .name { font-weight: 600; word-break: break-word; }
.c-prov, .c-date { font-size: 13px; word-break: break-word; }
.type { display: inline-block; font-size: 12px; font-weight: 600; padding: 1px 8px; border-radius: 99px; white-space: nowrap;
  color: var(--tc); background: color-mix(in srgb, var(--tc) 13%, transparent); }
.t-desktop_app { --tc: var(--t-desktop); } .t-store_app { --tc: var(--t-store); } .t-windows_update { --tc: var(--t-wu); }
.t-driver { --tc: var(--t-driver); } .t-dev_package { --tc: var(--t-dev); }
.ver { font-family: var(--mono); font-size: 13px; overflow-wrap: anywhere; }
.ver .old { display: block; color: var(--muted); text-decoration: line-through; }
.ver .new { display: block; }
.ver .arrow { color: var(--muted); padding-right: 4px; }
.conf { display: inline-block; font-size: 11px; padding: 0 6px; border-radius: 99px; background: var(--chip);
  color: var(--muted); margin-top: 2px; }
.desc { font-size: 14px; }
.src { display: inline-block; font-size: 11px; padding: 0 6px; border-radius: 4px; background: var(--chip);
  color: var(--muted); margin-left: 4px; vertical-align: 1px; }
.nodesc { color: var(--muted); font-style: italic; }
.src.yours { background: var(--installed-bg); color: var(--installed); }
.times { font-size: 12px; font-weight: 600; color: var(--muted); background: var(--chip); border-radius: 99px;
  padding: 0 6px; margin-left: 4px; }
.srclink { font-size: 12px; color: var(--focus); margin-left: 4px; }
.tagbtn { margin-left: 6px; font-size: 11px; padding: 1px 8px; border-radius: 99px; cursor: pointer;
  border: 1px dashed var(--muted); background: transparent; color: var(--muted); }
.tagbtn:hover { border-style: solid; color: var(--text); }
.tagcmd { display: block; margin-top: 6px; padding: 6px 8px; font-size: 12px; background: var(--chip);
  border-radius: 6px; user-select: all; word-break: break-all; }
.tagbtn.done { border-style: solid; color: var(--installed); border-color: var(--installed); }
details.ev { margin-top: 6px; font-size: 12px; color: var(--muted); }
details.ev summary { cursor: pointer; }
details.ev ul { margin: 4px 0 0; padding-left: 18px; }
details.routine { margin-top: 12px; }
details.routine > summary { cursor: pointer; color: var(--muted); font-size: 14px; padding: 6px 0; }
.empty { background: var(--panel); border: 1px dashed var(--line); border-radius: 12px; padding: 28px;
  text-align: center; color: var(--muted); margin-top: 24px; }
footer { margin-top: 48px; color: var(--muted); font-size: 13px; }
footer table { border-collapse: collapse; width: 100%; margin-top: 8px; background: var(--panel);
  border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
footer td, footer th { text-align: left; padding: 6px 10px; border-top: 1px solid var(--line); }
footer th { font-weight: 600; color: var(--text); border-top: 0; }
.ok { color: var(--installed); } .bad { color: var(--uninstalled); }
.hidden { display: none !important; }

@media (max-width: 900px) {
  .row { grid-template-columns: 1fr 1fr; gap: 6px 14px; }
  .row.head { display: none; }
  .c-name, .c-desc { grid-column: 1 / -1; }
  .c-type::before, .c-prov::before, .c-ver::before, .c-date::before { content: attr(data-label); display: block;
    font-size: 10px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); font-family: inherit; }
  .status { margin-left: 0; width: 100%; }
  .filters { position: static; }
}
@media (max-width: 520px) { .wrap { padding: 20px 16px 48px; } select { max-width: 100%; } }
</style>
</head>
<body>
<div class="wrap">
<header>
  <h1>What changed on {{ r.host }}{% if r.demo %}<span class="demo">sample data</span>{% endif %}</h1>
  <div class="meta">
    <b>{{ r.period_start|dt }}</b> → <b>{{ r.period_end|dt }}</b>
    · generated {{ r.generated_at|dt }}
    {% if r.baseline_at %} · compared with snapshot from {{ r.baseline_at|dt }}{% endif %}
    · {{ "administrator" if r.is_admin else "standard user" }}
  </div>
</header>

<div class="cards">
{% for a in actions %}
  <a class="card a-{{ a.value }}{% if not r.count(a) %} zero{% endif %}" href="#{{ a.value }}" data-card="{{ a.value }}">
    <div class="n">{{ r.count(a, False) }}</div>
    <div class="l">{{ a.label }}</div>
    {% set rt = r.count(a) - r.count(a, False) %}
    <div class="sub">{% if rt %}+ {{ rt }} routine{% endif %}</div>
  </a>
{% endfor %}
</div>

{% if r.warnings %}
<div class="warn"><b>Good to know</b>
  <ul>{% for w in r.warnings %}<li>{{ w }}</li>{% endfor %}</ul>
</div>
{% endif %}

{% if r.changes %}
<div class="filters" role="search" aria-label="Filter changes">
  <div class="frow">
    <input id="q" type="search" placeholder="Search name, provider or description…" aria-label="Search">
    <div class="field"><span class="lbl">Provider</span>
      <select id="prov" aria-label="Provider">
        <option value="">All providers ({{ r.providers()|length }})</option>
        {% for p, n in r.providers() %}<option value="{{ p }}">{{ p }} ({{ n }})</option>{% endfor %}
      </select>
    </div>
  </div>
  <div class="frow">
    <div class="field"><span class="lbl">Type</span>
      <div class="chips" id="types">
        {% for cat, n in r.categories() %}
        <button type="button" class="chip" data-cat="{{ cat.value }}" aria-pressed="false">{{ cat.short_label }} <span class="cnt">{{ n }}</span></button>
        {% endfor %}
      </div>
    </div>
    <div class="field"><span class="lbl">Date</span>
      <input id="from" type="date" aria-label="From date" min="{{ r.period_start|iso_day }}" max="{{ r.period_end|iso_day }}">
      <span>to</span>
      <input id="to" type="date" aria-label="To date" min="{{ r.period_start|iso_day }}" max="{{ r.period_end|iso_day }}">
      <button type="button" class="preset" data-days="1">Last 24h</button>
      <button type="button" class="preset" data-days="7">7 days</button>
      <button type="button" class="preset" data-days="0">All</button>
    </div>
  </div>
  <div class="frow">
    <label class="check"><input id="showRoutine" type="checkbox"> Show routine items</label>
    <button type="button" class="linkbtn" id="reset">Reset filters</button>
    <span class="status" id="status" aria-live="polite"></span>
  </div>
</div>
{% endif %}

{% for s in r.sections() %}
<section class="action a-{{ s.action.value }}" id="{{ s.action.value }}" data-section="{{ s.action.value }}">
  <h2>{{ s.action.label }} <span class="pill">{{ s.total }}</span></h2>
  <p class="blurb">{{ s.blurb }}</p>
  {% if s.items %}
  <div class="rows notable">{{ head() }}{% for c in s.items %}{{ row(c) }}{% endfor %}</div>
  {% endif %}
  {% if s.routine %}
  <details class="routine">
    <summary><span class="rcount">{{ s.routine|length }}</span> routine <span class="rword">{{ "item" if s.routine|length == 1 else "items" }}</span>
      (antivirus definitions, browser and Store auto-updates …)</summary>
    <div class="rows">{{ head() }}{% for c in s.routine %}{{ row(c, True) }}{% endfor %}</div>
  </details>
  {% endif %}
</section>
{% else %}
<div class="empty">Nothing was installed, updated or removed in this period.</div>
{% endfor %}
<div class="empty hidden" id="noresults">No changes match these filters. <button type="button" class="preset" id="reset2">Reset filters</button></div>

<footer>
  <b>Sources checked</b>
  <table>
    <tr><th>Source</th><th>Status</th><th>Items</th><th>Events</th><th>Time</th></tr>
    {% for s in r.collector_status %}
    <tr><td>{{ s.name }}</td>
      <td class="{{ 'ok' if s.ok else 'bad' }}">{{ "ok" if s.ok else "not used" }}{% if s.message %} — {{ s.message }}{% endif %}</td>
      <td>{{ s.items or "" }}</td><td>{{ s.events or "" }}</td><td>{{ "%.1fs"|format(s.seconds) if s.seconds else "" }}</td></tr>
    {% endfor %}
  </table>
  <p>“exact” times come from Windows logs; “approx.” from file or registry write times; “between scans”
  means the change was detected by comparing snapshots, so it matches any date in that range when filtering.
  Descriptions and providers marked <span class="src">AI</span> weren't available on this PC and were
  filled in by Claude; they may be imprecise for obscure software. <span class="src yours">yours</span> marks
  your own tags. Use <b>Tag it</b> on a row (or <code>sysscan unknowns --edit</code>) to identify something
  yourself, then <code>sysscan retag</code>.{% if r.ai_used %} AI was enabled for this scan.{% endif %}</p>
  <p>sysscan {{ r.tool_version }}</p>
</footer>
</div>

<script>
(function () {
  var $ = function (s, el) { return (el || document).querySelector(s); };
  var $$ = function (s, el) { return Array.prototype.slice.call((el || document).querySelectorAll(s)); };
  var q = $('#q');
  if (!q) return;
  var prov = $('#prov'), from = $('#from'), to = $('#to'), routineBox = $('#showRoutine');
  var periodEnd = to.max;
  var rows = $$('.row:not(.head)');
  rows.forEach(function (r) { r._text = r.textContent.toLowerCase(); });

  function selectedCats() {
    return $$('#types .chip[aria-pressed=true]').map(function (b) { return b.dataset.cat; });
  }

  function matches(r, term, cats, p, f, t) {
    if (term && r._text.indexOf(term) === -1) return false;
    if (cats.length && cats.indexOf(r.dataset.cat) === -1) return false;
    if (p && r.dataset.prov !== p) return false;
    if (f || t) {
      var d0 = r.dataset.d0, d1 = r.dataset.d1;
      if (!d0) return false;                 // unknown date can't satisfy a date filter
      if (f && d1 < f) return false;         // ended before the range
      if (t && d0 > t) return false;         // started after the range
    }
    return true;
  }

  function apply() {
    var term = q.value.trim().toLowerCase(), cats = selectedCats(), p = prov.value;
    var f = from.value, t = to.value;
    if (f && t && f > t) { var x = f; f = t; t = x; }
    var shown = 0, counts = {};
    rows.forEach(function (r) {
      var ok = matches(r, term, cats, p, f, t);
      r.classList.toggle('hidden', !ok);
      if (!ok) return;
      shown++;
      var c = counts[r.dataset.action] || (counts[r.dataset.action] = { n: 0, routine: 0 });
      if (r.dataset.routine === '1') c.routine++; else c.n++;
    });

    $$('section.action').forEach(function (sec) {
      var c = counts[sec.dataset.section] || { n: 0, routine: 0 };
      sec.classList.toggle('hidden', c.n + c.routine === 0);
      $('.pill', sec).textContent = c.n + c.routine;
      var notable = $('.rows.notable', sec);
      if (notable) notable.classList.toggle('hidden', c.n === 0);
      var det = $('details.routine', sec);
      if (det) {
        det.classList.toggle('hidden', c.routine === 0);
        $('.rcount', det).textContent = c.routine;
        $('.rword', det).textContent = c.routine === 1 ? 'item' : 'items';
        det.open = routineBox.checked;
      }
    });

    $$('[data-card]').forEach(function (card) {
      var c = counts[card.dataset.card] || { n: 0, routine: 0 };
      $('.n', card).textContent = c.n;
      $('.sub', card).textContent = c.routine ? '+ ' + c.routine + ' routine' : '';
      card.classList.toggle('zero', c.n + c.routine === 0);
    });

    var filtered = term || cats.length || p || f || t;
    $('#status').textContent = filtered ? 'Showing ' + shown + ' of ' + rows.length + ' changes'
                                        : rows.length + ' changes';
    $('#noresults').classList.toggle('hidden', shown > 0);
  }

  function reset() {
    q.value = ''; prov.value = ''; from.value = ''; to.value = '';
    $$('#types .chip').forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
    apply();
  }

  function isoDay(d) {
    var m = d.getMonth() + 1, day = d.getDate();
    return d.getFullYear() + '-' + (m < 10 ? '0' : '') + m + '-' + (day < 10 ? '0' : '') + day;
  }

  $$('#types .chip').forEach(function (b) {
    b.addEventListener('click', function () {
      b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      apply();
    });
  });
  $$('.preset[data-days]').forEach(function (b) {
    b.addEventListener('click', function () {
      var days = +b.dataset.days;
      if (!days) { from.value = ''; to.value = ''; }
      else {
        var end = new Date(periodEnd + 'T12:00:00');
        var start = new Date(end.getTime() - (days - 1) * 86400000);
        from.value = isoDay(start) < from.min ? from.min : isoDay(start);
        to.value = periodEnd;
      }
      apply();
    });
  });
  [q].forEach(function (el) { el.addEventListener('input', apply); });
  [prov, from, to, routineBox].forEach(function (el) { el.addEventListener('change', apply); });
  $('#reset').addEventListener('click', reset);
  $('#reset2').addEventListener('click', reset);

  // Column sorting — applies to every table so they stay consistent.
  var keyFns = {
    name: function (r) { return $('.name', r).textContent.toLowerCase(); },
    cat: function (r) { return r.dataset.cat; },
    prov: function (r) { return r.dataset.prov.toLowerCase(); },
    date: function (r) { return r.dataset.sort; }
  };
  $$('.sort').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.dataset.key;
      var dir = btn.getAttribute('aria-sort') === 'ascending' ? 'descending'
              : btn.getAttribute('aria-sort') === 'descending' ? 'ascending'
              : (key === 'date' ? 'descending' : 'ascending');
      $$('.sort').forEach(function (b) {
        b.setAttribute('aria-sort', b.dataset.key === key ? dir : 'none');
      });
      var fn = keyFns[key], sign = dir === 'ascending' ? 1 : -1;
      $$('.rows').forEach(function (box) {
        $$('.row:not(.head)', box)
          .sort(function (a, b) { var x = fn(a), y = fn(b); return x < y ? -sign : x > y ? sign : 0; })
          .forEach(function (r) { box.appendChild(r); });
      });
    });
  });

  // "Tag it": copy a ready-to-edit `sysscan tag …` command.
  function copyFallback(text) {
    var ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
    document.body.removeChild(ta);
    return ok ? Promise.resolve() : Promise.reject(new Error('copy blocked'));
  }
  function copy(text) {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text).catch(function () { return copyFallback(text); });
    }
    return copyFallback(text);
  }
  $$('.tagbtn').forEach(function (b) {
    b.addEventListener('click', function () {
      copy(b.dataset.cmd).then(function () {
        b.textContent = 'Copied: paste in PowerShell'; b.classList.add('done');
        setTimeout(function () { b.textContent = 'Tag it'; b.classList.remove('done'); }, 2500);
      }, function () {
        // Clipboard blocked (some browsers restrict local files): show the command to copy by hand.
        if (!b.nextElementSibling || !b.nextElementSibling.classList.contains('tagcmd')) {
          var code = document.createElement('code'); code.className = 'tagcmd'; code.textContent = b.dataset.cmd;
          b.insertAdjacentElement('afterend', code);
          var range = document.createRange(); range.selectNodeContents(code);
          var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(range);
        }
      });
    });
  });

  apply();
})();
</script>
</body>
</html>
