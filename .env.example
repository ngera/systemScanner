# sysscan settings. Copy this file to ".env" and fill it in.
# sysscan looks for .env in: the current folder, next to runScan.exe/runScan.com, the project root,
# and %LOCALAPPDATA%\sysscan\ (use that one if scans run from Task Scheduler).
# Real environment variables take precedence over this file. Never commit your .env.

# Turn AI enrichment on or off: true / false. Overrides config.toml; --ai / --no-ai override this.
SYSSCAN_AI=true

# Provider: claude (Anthropic cloud, default) or ollama (local, nothing leaves the machine).
# SYSSCAN_AI_PROVIDER=claude

# --- Claude (Anthropic) ---
# API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# SYSSCAN_AI_MODEL=claude-haiku-4-5

# --- Ollama (local) ---
# Install from https://ollama.com/ then: ollama pull llama3.2
# SYSSCAN_AI_PROVIDER=ollama
# SYSSCAN_AI_MODEL=llama3.2
# SYSSCAN_AI_BASE_URL=http://127.0.0.1:11434

# Optional
# SYSSCAN_AI_MAX_ITEMS=150

# Second pass with web search for items the first pass couldn't identify (~$0.01 per search, max 2 per item).
# Claude only — ignored when SYSSCAN_AI_PROVIDER=ollama.
# Each product is web-searched at most once; answers are cached.
# SYSSCAN_AI_WEB=true
# SYSSCAN_AI_WEB_MAX_ITEMS=15
